# =====================================================================
# CampusPulse — Environment Configuration Template (.env.example)
# Copy this file to '.env' (or 'backend/.env') and customize for your environment.
# DO NOT commit '.env' containing real secrets to Git.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (Oracle 21c Database is PRIMARY & AUTHORITATIVE)
# ---------------------------------------------------------------------
# Option A: Full Connection URL
# Format: oracle+oracledb://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/?service_name=<DB_SERVICE_NAME>
#
# NOTE ON SPECIAL CHARACTERS:
# If your DB_PASSWORD contains special characters (e.g. @, #, $, /, :, %),
# they MUST be percent-encoded (URL-encoded):
#   @  ->  %40
#   #  ->  %23
#   $  ->  %24
#   /  ->  %2F
#   :  ->  %3A
#   %  ->  %25
#
# Example Oracle Free / 21c XE local connection:
DATABASE_URL=oracle+oracledb://campuspulse:your_secure_password@localhost:1521/?service_name=XEPDB1

# Option B: Individual Connection Fields (Alternative if DATABASE_URL is not set)
# DB_USER=campuspulse
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=1521
# DB_SERVICE_NAME=XEPDB1

# SQLite Local Development / Automated Offline Unit Testing ONLY
# To explicitly use SQLite instead of Oracle, uncomment:
# DATABASE_URL=sqlite:///./campuspulse.db

# ---------------------------------------------------------------------
# Server & CORS Configuration
# ---------------------------------------------------------------------
# JSON list or comma-separated origins allowed to make authenticated API requests
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
